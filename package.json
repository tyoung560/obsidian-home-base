{
  "name": "obsidian-home-base",
  "version": "0.1.1",
  "description": "A task and project workspace for an Obsidian vault: Home, board, capture, review, ops, meetings and daily logs, all stored as notes.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.18.0",
    "builtin-modules": "5.0.0",
    "esbuild": "0.25.10",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
